rules_version = '2';

// Garage Log shared garages. The app keeps Room as its source of truth and syncs whole records
// (last write wins by updatedAt, soft delete via `deleted`), so these rules guard records, not
// queries: who may read a vehicle's data, and which fields a Standard member may change.
//
// Roles, per garage (garages/{g}/members/{uid}.role):
//   admin    — everything in the garage: vehicles, schedules, members, invites.
//   standard — only the vehicles in their member doc's vehicleIds. May add and edit logs and
//              issues (fuel, mileage, service, repairs) and photos on them. On the vehicle itself
//              may only move the odometer; on a schedule only the "last done" fields — both are
//              side effects of saving a log, never edited directly.
//
// Nothing is ever hard-deleted from the app; a delete is an update setting `deleted`.
// Paste into Firebase console -> Firestore -> Rules, or deploy with the Firebase CLI.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email.lower(); }

    function memberPath(g) { return /databases/$(database)/documents/garages/$(g)/members/$(uid()); }
    function isMember(g) { return signedIn() && exists(memberPath(g)); }
    function me(g) { return get(memberPath(g)).data; }
    function isAdmin(g) { return isMember(g) && me(g).role == 'admin'; }
    function canSee(g, vehicleId) {
      return isMember(g) && (me(g).role == 'admin' || vehicleId in me(g).vehicleIds);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Per-person data: reminder settings and which garages they belong to. Nobody else's business.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /garages/{g} {
      allow read: if isMember(g);
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update: if isAdmin(g) && request.resource.data.createdBy == resource.data.createdBy;

      match /members/{memberId} {
        // Standard members see only their own doc; admins see everyone.
        allow read: if isAdmin(g) || (signedIn() && memberId == uid());
        allow create: if
          // An admin adds someone directly.
          isAdmin(g)
          // The garage's creator makes themself its first admin.
          || (signedIn() && memberId == uid()
              && get(/databases/$(database)/documents/garages/$(g)).data.createdBy == uid()
              && request.resource.data.role == 'admin')
          // Someone accepts their invite, with exactly the role and vehicles it offered.
          || (signedIn() && memberId == uid()
              && exists(/databases/$(database)/documents/garages/$(g)/invites/$(myEmail()))
              && request.resource.data.role
                   == get(/databases/$(database)/documents/garages/$(g)/invites/$(myEmail())).data.role
              && request.resource.data.vehicleIds
                   == get(/databases/$(database)/documents/garages/$(g)/invites/$(myEmail())).data.vehicleIds);
        allow update, delete: if isAdmin(g);
      }

      // Keyed by the invitee's lower-cased email.
      match /invites/{email} {
        allow read: if isAdmin(g) || (signedIn() && email == myEmail());
        allow create, update: if isAdmin(g) && request.resource.data.email == email;
        // The invitee removes it once accepted (or to decline).
        allow delete: if isAdmin(g) || (signedIn() && email == myEmail());
      }

      match /vehicles/{vehicleId} {
        allow read: if canSee(g, vehicleId);
        allow create: if isAdmin(g);
        allow update: if isAdmin(g)
          || (canSee(g, vehicleId) && onlyChanges(['miles', 'milesDate', 'updatedAt', 'serverUpdatedAt']));
      }

      match /schedules/{id} {
        allow read: if canSee(g, resource.data.vehicleId);
        allow create: if isAdmin(g);
        allow update: if isAdmin(g)
          || (canSee(g, resource.data.vehicleId)
              && onlyChanges(['lastDoneMileage', 'lastDoneDate', 'updatedAt', 'serverUpdatedAt']));
      }

      // Logs, issues and photos all carry vehicleId. A record can't be moved onto a vehicle the
      // member can't see, and an existing one can't be pulled off one.
      match /{kind}/{id} {
        allow read: if kind in ['logs', 'issues', 'photos'] && canSee(g, resource.data.vehicleId);
        allow create: if kind in ['logs', 'issues', 'photos'] && canSee(g, request.resource.data.vehicleId);
        allow update: if kind in ['logs', 'issues', 'photos']
          && canSee(g, resource.data.vehicleId)
          && canSee(g, request.resource.data.vehicleId);
      }
    }

    // Finding your invites before you're in the garage: a collection-group query on `email`.
    match /{path=**}/invites/{email} {
      allow read: if signedIn() && email == myEmail();
    }
  }
}
